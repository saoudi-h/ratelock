{
    "name": "@ratelock/express",
    "version": "0.1.0",
    "description": "Rate limiting middleware for Express — engine-agnostic, powered by any RateLock limiter",
    "keywords": [
        "rate-limit",
        "rate-limiting",
        "express",
        "middleware",
        "ratelock"
    ],
    "homepage": "https://github.com/saoudi-h/ratelock",
    "bugs": {
        "url": "https://github.com/saoudi-h/ratelock/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/saoudi-h/ratelock.git",
        "directory": "packages/express"
    },
    "license": "MIT",
    "author": {
        "name": "Saoudi Hakim",
        "url": "https://hakimsaoudi.dev",
        "email": "saoudihakim@gmail.com"
    },
    "type": "module",
    "main": "./dist/index.cjs",
    "types": "./dist/index.d.cts",
    "exports": {
        ".": {
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsdown",
        "dev": "tsdown --watch",
        "lint": "eslint . --max-warnings 0",
        "lint:fix": "eslint . --max-warnings 0 --fix",
        "format": "prettier \"**/*\" --ignore-unknown --list-different",
        "format:fix": "prettier \"**/*\" --ignore-unknown --write",
        "clean": "rimraf dist .turbo node_modules",
        "typecheck": "tsgo --noEmit",
        "test": "vitest",
        "test:run": "vitest run",
        "pre-commit": "lint-staged"
    },
    "peerDependencies": {
        "express": "^4.21.0 || ^5.0.0"
    },
    "devDependencies": {
        "@ratelock/core": "workspace:*",
        "@ratelock/local": "workspace:*",
        "@tala-tools/eslint": "0.1.6",
        "@tala-tools/prettier": "0.0.3",
        "@tala-tools/tsconfig": "0.0.2",
        "@types/express": "^5.0.0",
        "@types/node": "^26.2.0",
        "@types/supertest": "^6.0.0",
        "express": "^5.1.0",
        "express4": "npm:express@^4.21.2",
        "supertest": "^7.1.0",
        "vitest": "^4.1.10"
    },
    "engines": {
        "node": ">=22",
        "bun": ">=1.1"
    },
    "sideEffects": false,
    "module": "./dist/index.mjs"
}
