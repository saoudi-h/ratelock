{
    "name": "@ratelock/bench",
    "private": true,
    "type": "module",
    "scripts": {
        "bench:local": "tsx src/index.ts --legacy",
        "bench:local:bun": "bun --bun run src/index.ts --legacy",
        "bench:full": "docker compose up -d && tsx src/index.ts; status=$?; docker compose down; exit $status",
        "bench:full:bun": "docker compose up -d && bun --bun run src/index.ts; status=$?; docker compose down; exit $status",
        "bench:full:gc": "docker compose up -d && NODE_OPTIONS='--expose-gc' BENCH_GC=true tsx src/index.ts; status=$?; docker compose down; exit $status",
        "bench:fair": "docker compose up -d && taskset -c 0 tsx src/index.ts; status=$?; docker compose down; exit $status",
        "bench": "tsx src/index.ts --legacy",
        "bench:drivers": "tsx src/driver-compare.ts",
        "bench:drivers:bun": "bun src/driver-compare.ts",
        "lint": "oxlint --deny-warnings .",
        "lint:fix": "oxlint --fix .",
        "format": "oxfmt --check .",
        "format:fix": "oxfmt --write .",
        "clean": "rimraf node_modules .turbo",
        "typecheck": "tsc --noEmit",
        "pre-commit": "lint-staged"
    },
    "dependencies": {
        "@ratelock/core": "workspace:*",
        "@ratelock/local": "workspace:*",
        "@ratelock/postgres": "workspace:*",
        "@ratelock/redis": "workspace:*",
        "ioredis": "^6.0.0",
        "pg": "^8.23.0",
        "postgres": "^3.4.9",
        "rate-limiter-flexible": "^11.2.0",
        "redis": "^6.2.1"
    },
    "devDependencies": {
        "@tala-tools/tsconfig": "0.0.2",
        "@types/node": "^26.2.0",
        "@types/pg": "^8.23.1",
        "tsx": "^4.23.12",
        "typescript": "7.0.2"
    },
    "engines": {
        "bun": ">=1.1",
        "node": ">=22"
    }
}
