{
    "name": "@ratelock/core",
    "version": "0.2.1",
    "description": "Core RateLock rate limiting system",
    "keywords": [
        "bun",
        "core",
        "cross-runtime",
        "express",
        "fastify",
        "middleware",
        "nestjs",
        "nextjs",
        "rate-lock",
        "rate-locking",
        "ratelimit",
        "redis",
        "security",
        "typescript"
    ],
    "homepage": "https://github.com/saoudi-h/ratelock",
    "bugs": {
        "url": "https://github.com/saoudi-h/ratelock/issues"
    },
    "license": "MIT",
    "author": {
        "name": "Saoudi Hakim",
        "email": "saoudihakim@gmail.com",
        "url": "https://hakimsaoudi.dev"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/saoudi-h/ratelock.git",
        "directory": "packages/core"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.cts",
    "exports": {
        ".": {
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs"
        },
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsdown",
        "dev": "tsdown --watch",
        "lint": "oxlint --deny-warnings .",
        "lint:fix": "oxlint --fix .",
        "format": "oxfmt --check .",
        "format:fix": "oxfmt --write .",
        "clean": "rimraf dist .turbo node_modules",
        "typecheck": "tsc --noEmit",
        "test": "vitest",
        "test:ui": "vitest --ui",
        "test:run": "vitest run",
        "test:coverage": "vitest run --coverage",
        "prepack": "tsdown",
        "prepublishOnly": "pnpm run build",
        "pre-commit": "lint-staged"
    },
    "devDependencies": {
        "@ratelock/vitest": "workspace:*",
        "@tala-tools/tsconfig": "0.0.2",
        "@types/node": "^26.2.0",
        "@vitest/coverage-v8": "^4.1.11",
        "vitest": "^4.1.11"
    },
    "engines": {
        "bun": ">=1.1",
        "node": ">=22"
    }
}
