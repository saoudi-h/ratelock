{
    "name": "@ratelock/redis-common",
    "version": "0.0.0",
    "private": true,
    "description": "Internal shared Redis-script strategies for RateLock adapters",
    "license": "MIT",
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.cts",
    "exports": {
        ".": {
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "tsdown",
        "lint": "oxlint --deny-warnings .",
        "lint:fix": "oxlint --fix .",
        "format": "oxfmt --check .",
        "format:fix": "oxfmt --write .",
        "clean": "rimraf dist .turbo node_modules",
        "typecheck": "tsc --noEmit",
        "test": "vitest",
        "test:run": "vitest run",
        "pre-commit": "lint-staged"
    },
    "dependencies": {
        "@ratelock/core": "workspace:*"
    },
    "devDependencies": {
        "@tala-tools/tsconfig": "0.0.2",
        "@types/node": "^26.2.0",
        "rimraf": "^6.1.3",
        "typescript": "7.0.2",
        "vitest": "^4.1.11"
    },
    "engines": {
        "node": ">=22"
    }
}
