{
    "name": "@ratelock/http-common",
    "version": "0.0.0",
    "private": true,
    "description": "Internal shared logic for RateLock framework integrations. Never published; bundled into consumers at build time.",
    "license": "MIT",
    "type": "module",
    "main": "./dist/index.cjs",
    "types": "./dist/index.d.cts",
    "exports": {
        ".": {
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "tsdown",
        "lint": "eslint . --max-warnings 0",
        "lint:fix": "eslint . --max-warnings 0 --fix",
        "format": "prettier \"**/*\" --ignore-unknown --list-different",
        "format:fix": "prettier \"**/*\" --ignore-unknown --write",
        "clean": "rimraf dist .turbo node_modules",
        "typecheck": "tsgo --noEmit",
        "test": "vitest",
        "test:run": "vitest run",
        "pre-commit": "lint-staged"
    },
    "dependencies": {},
    "devDependencies": {
        "@ratelock/core": "workspace:*",
        "@tala-tools/eslint": "0.1.6",
        "@tala-tools/prettier": "0.0.3",
        "@tala-tools/tsconfig": "0.0.2",
        "@types/node": "^26.2.0",
        "vitest": "^4.1.10"
    },
    "engines": {
        "node": ">=22",
        "bun": ">=1.1"
    },
    "sideEffects": false,
    "module": "./dist/index.mjs"
}
