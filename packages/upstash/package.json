{
    "name": "@ratelock/upstash",
    "version": "0.2.1",
    "description": "Edge-compatible Upstash Redis storage backend for RateLock",
    "keywords": [
        "edge",
        "rate-limit",
        "rate-limiting",
        "ratelock",
        "serverless",
        "upstash"
    ],
    "homepage": "https://github.com/saoudi-h/ratelock",
    "bugs": {
        "url": "https://github.com/saoudi-h/ratelock/issues"
    },
    "license": "MIT",
    "author": {
        "name": "Saoudi Hakim",
        "email": "saoudihakim@gmail.com",
        "url": "https://hakimsaoudi.dev"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/saoudi-h/ratelock.git",
        "directory": "packages/upstash"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.cts",
    "exports": {
        ".": {
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs"
        },
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsdown",
        "dev": "tsdown --watch",
        "test": "vitest --exclude \"**/__integration__/**\"",
        "test:ui": "vitest --exclude \"**/__integration__/**\" --ui",
        "test:run": "vitest run --exclude \"**/__integration__/**\"",
        "test:integration": "node scripts/test-integration.mjs",
        "test:integration:remote": "vitest run --config vitest.integration.config.ts",
        "lint": "oxlint --deny-warnings .",
        "lint:fix": "oxlint --fix .",
        "format": "oxfmt --check .",
        "format:fix": "oxfmt --write .",
        "clean": "rimraf dist .turbo node_modules",
        "typecheck": "tsc --noEmit",
        "prepack": "tsdown",
        "pre-commit": "lint-staged"
    },
    "dependencies": {
        "@ratelock/core": "workspace:*"
    },
    "devDependencies": {
        "@ratelock/redis-common": "workspace:*",
        "@ratelock/test-utils": "workspace:*",
        "@ratelock/vitest": "workspace:*",
        "@tala-tools/tsconfig": "0.0.2",
        "@types/node": "^26.2.0",
        "@upstash/redis": "^1.38.4",
        "rimraf": "^6.1.3",
        "typescript": "7.0.2",
        "vitest": "^4.1.11"
    },
    "peerDependencies": {
        "@upstash/redis": ">=1.34.0 <2"
    },
    "engines": {
        "node": ">=22"
    }
}
