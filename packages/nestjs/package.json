{
    "name": "@ratelock/nestjs",
    "version": "0.1.1",
    "description": "Rate limiting module for NestJS — engine-agnostic guard powered by any RateLock limiter",
    "keywords": [
        "guard",
        "middleware",
        "nestjs",
        "rate-limit",
        "rate-limiting",
        "ratelock"
    ],
    "homepage": "https://github.com/saoudi-h/ratelock",
    "bugs": {
        "url": "https://github.com/saoudi-h/ratelock/issues"
    },
    "license": "MIT",
    "author": {
        "name": "Saoudi Hakim",
        "email": "saoudihakim@gmail.com",
        "url": "https://hakimsaoudi.dev"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/saoudi-h/ratelock.git",
        "directory": "packages/nestjs"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.cts",
    "exports": {
        ".": {
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "tsdown",
        "dev": "tsdown --watch",
        "lint": "oxlint --deny-warnings .",
        "lint:fix": "oxlint --fix .",
        "format": "oxfmt --check .",
        "format:fix": "oxfmt --write .",
        "clean": "rimraf dist .turbo node_modules",
        "typecheck": "tsc --noEmit",
        "test": "vitest",
        "test:run": "vitest run",
        "pre-commit": "lint-staged"
    },
    "devDependencies": {
        "@nestjs/common": "^11.0.0",
        "@nestjs/core": "^11.0.0",
        "@nestjs/platform-express": "^11.0.0",
        "@nestjs/platform-fastify": "^11.0.0",
        "@nestjs/testing": "^11.0.0",
        "@ratelock/core": "workspace:*",
        "@ratelock/http-common": "workspace:*",
        "@ratelock/local": "workspace:*",
        "@tala-tools/tsconfig": "0.0.2",
        "@types/node": "^26.2.0",
        "@types/supertest": "^7.2.1",
        "reflect-metadata": "^0.2.0",
        "rxjs": "^7.8.0",
        "supertest": "^7.1.0",
        "vitest": "^4.1.11"
    },
    "peerDependencies": {
        "@nestjs/common": "^10.0.0 || ^11.0.0",
        "@nestjs/core": "^10.0.0 || ^11.0.0"
    },
    "engines": {
        "node": ">=22"
    }
}
